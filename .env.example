# Supabase Configuration
# Copy this file to .env.local and fill in your actual values
# IMPORTANT: NEVER commit .env.local to version control!

# Supabase Project URL (safe to expose - it's the API endpoint)
VITE_SUPABASE_URL=https://mlqzeihukezlozooqhko.supabase.co

# Supabase Anonymous Key (needed for frontend, but protect it)
# Get your key from: https://supabase.com/dashboard/project/mlqzeihukezlozooqhko/settings/api
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Enable debug mode
# VITE_DEBUG=false

# Optional: API timeout (in milliseconds)
# VITE_API_TIMEOUT=30000
